# Unreal Engine Gitignore for EstacionNueveBP

# Build and temporary files
Binaries/*
DerivedDataCache/*
Intermediate/*
Saved/*
Build/*

# Visual Studio / Rider / VS Code temporary files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.opendb
*.sdf
*.VC.db
*.VC.opendb

# Autogenerated files and crash reports
*.log
*.tmp
*.bak
CrashReportClient/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode & Scripts
__pycache__/
*.py[cod]
*$py.class
Scripts/
*.t3d

# Temporary Editor Plugins
Plugins/
 
scratch/
